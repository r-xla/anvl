```python
import jax
import jax.numpy as jnp
from jax import random
from jax.experimental import random as xrandom

def show(rng, label):
    print(f"{label:<28} base_key = {random.key_data(rng._base_key)}   counter = {int(rng._counter[...])}")

rng = xrandom.stateful_rng(42)
show(rng, "after stateful_rng(42):")

x1 = rng.normal(size=3)
show(rng, "after rng.normal(size=3):")
x2 = rng.normal(size=1000)
show(rng, "after rng.normal(size=1000):")
x3 = rng.uniform()
show(rng, "after rng.uniform():")

# each call n uses the key fold_in(base_key, n); the base key never changes
base = random.key(42)
print()
print("rng.normal(size=3)   == random.normal(fold_in(base, 0), (3,))   :",
      bool(jnp.all(x1 == random.normal(random.fold_in(base, 0), (3,)))))
print("rng.normal(size=1000)== random.normal(fold_in(base, 1), (1000,)):",
      bool(jnp.all(x2 == random.normal(random.fold_in(base, 1), (1000,)))))
print("rng.uniform()        == random.uniform(fold_in(base, 2))        :",
      bool(x3 == random.uniform(random.fold_in(base, 2))))

# spawn: parent counter +1, children get new base keys and fresh counters
print()
children = rng.spawn(2)
show(rng, "parent after spawn(2):")
for i, c in enumerate(children):
    show(c, f"child {i}:")
expected = random.split(random.fold_in(base, 3), 2)
print("child base keys == split(fold_in(base, 3), 2):",
      bool(jnp.all(random.key_data(jnp.stack([c._base_key for c in children])) == random.key_data(expected))))
```

